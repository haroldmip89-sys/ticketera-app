# Plantilla de variables de entorno. Copia este archivo a .env (o .env.local) y completa los valores.
# Nunca subas .env ni .env.local al repositorio: solo este archivo, sin valores.

# Clerk — dashboard.clerk.com → API keys (framework Next.js). Instancia Development: pk_test_… / sk_test_…
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk — Webhooks → endpoint /api/webhooks/clerk → Signing secret (whsec_…). Se usa cuando exista la base de datos.
CLERK_WEBHOOK_SIGNING_SECRET=

# Stripe — dashboard.stripe.com → Developers → API keys (modo test: pk_test_… / sk_test_…)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Stripe — en local lo imprime `stripe listen --forward-to localhost:3000/api/webhooks/stripe` (whsec_…)
STRIPE_WEBHOOK_SECRET=

# Neon — console.neon.tech → Connect → branch dev → cadena de conexión con pooling (postgresql://…?sslmode=require)
DATABASE_URL=
